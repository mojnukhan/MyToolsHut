# MyToolsHut Environment Configuration Example

# For local development (SQLite):
DATABASE_URL="file:./dev.db"

# For production deployment (PostgreSQL):
# DATABASE_URL="postgresql://username:password@localhost:5432/mytoolshut?schema=public"

# Base public site URL
NEXT_PUBLIC_SITE_URL="https://mytoolshut.com"

# Admin Authentication Secret
ADMIN_SECRET_KEY="replace-with-a-strong-random-secret-in-production"

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"

